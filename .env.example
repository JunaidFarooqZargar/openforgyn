# ── Model Configuration ──────────────────────────────────────────────
# Main model for chat and reasoning
FORGYN_MODEL=openai/gpt-4o

# (Optional) Stronger model for code generation — falls back to FORGYN_MODEL
# FORGYN_CODE_MODEL=openai/o3

# ── LLM Provider Keys (set the one matching your FORGYN_MODEL) ──────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram Bot (optional — only needed for `forgyn telegram`) ─────
# Create a bot via @BotFather on Telegram to get this token
# TELEGRAM_BOT_TOKEN=

# ── Optional API Keys (skills may use these) ────────────────────────
# OPENWEATHERMAP_API_KEY=
# SERPER_API_KEY=
